#!/usr/bin/env bash
# Refresh packages/_1password-gui/sources.json to the newest stable 1Password.
#
# The two version probes are the ones nixpkgs' own
# pkgs/by-name/_1/_1password-gui/update.sh runs against: 1Password's Linux APT
# index (amd64 only -- it stands in for arm64) and the Mac app-update feed the
# app itself calls.  The hashes come from nix-prefetch-url; its default mode is
# what these URLs want from fetchurl, the sha256 of the file, not of the tree
# stdenv unpacks it into.
#
# What gets written is only the os/arch pairs sources.json already lists, so a
# new platform is added by editing that file, and nothing here downloads what no
# host of ours runs.
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
json=$here/../packages/_1password-gui/sources.json
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

APT_INDEX=https://downloads.1password.com/linux/debian/amd64/dists/stable/main/binary-amd64/Packages
# The trailing N is the stable channel; Y is beta.
APP_UPDATES=https://app-updates.agilebits.com/check/2/99/aarch64/OPM8/en/0/A1/N
UA='user-agent: nix-home#bump-1password'

# Package: 1password (the GUI) and Version:, so the awk skips the 1password-cli
# entry that shares the index.
linux_version() {
    curl -fsSL -H "$UA" "$APT_INDEX" |
        awk '/^Package: 1password$/ { gui = 1 } /^Version/ && gui { print $2; exit }'
}

darwin_version() {
    curl -fsSL -H "$UA" "$APP_UPDATES" | jq -r '.version // empty'
}

# The URL each platform's artifact lives at, mirrored by
# packages/_1password-gui/default.nix's fetchurl.
url_for() { # os arch version
    case $1/$2 in
    darwin/*) echo "https://downloads.1password.com/mac/1Password-$3-$2.zip" ;;
    linux/x86_64) echo "https://downloads.1password.com/linux/tar/stable/x86_64/1password-$3.x64.tar.gz" ;;
    linux/aarch64) echo "https://downloads.1password.com/linux/tar/stable/aarch64/1password-$3.arm64.tar.gz" ;;
    *) return 1 ;;
    esac
}

# nix-prefetch-url prints nix's base32; fetchurl wants SRI.
hash_for() {
    local b32
    b32=$(nix-prefetch-url "$1" 2>/dev/null | tail -1)
    nix hash to-sri --type sha256 "$b32"
}

versions=$(jq -n --arg linux "$(linux_version)" --arg darwin "$(darwin_version)" \
    '{linux: $linux, darwin: $darwin}')

for os in $(jq -r 'keys[]' "$json"); do
    version=$(echo "$versions" | jq -r --arg os "$os" '.[$os]')
    if [ -z "$version" ] || [ "$version" = null ]; then
        echo "no upstream version for $os, leaving it alone" >&2
        continue
    fi
    for arch in $(jq -r --arg os "$os" '.[$os].sources | keys[]' "$json"); do
        url=$(url_for "$os" "$arch" "$version")
        hash=$(hash_for "$url")
        echo "$os/$arch $version"
        jq --arg os "$os" --arg arch "$arch" --arg v "$version" \
            --arg url "$url" --arg hash "$hash" \
            '.[$os].version = $v | .[$os].sources[$arch] = {url: $url, hash: $hash}' \
            "$json" >"$tmp" &&
            cp "$tmp" "$json"
    done
done

echo
jq -r 'to_entries[] | "\(.key) \(.value.version)"' "$json"
echo
echo "then: nix build --no-link '.#nixosConfigurations.asche.pkgs._1password-gui'"
