#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: $0 <pr-url|pr-number|branch>"
  echo "Example: $0 https://github.com/owner/repo/pull/123"
  echo "Example: $0 123"
  echo "Example: $0 feature/foo"
}

if [ $# -ne 1 ]; then
  usage
  exit 1
fi

TARGET="$1"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "error: not inside a git repository" >&2
  exit 1
fi

if ! command -v pi >/dev/null 2>&1; then
  echo "error: pi not found on PATH" >&2
  exit 1
fi

is_pr_target() {
  case "$1" in
    http://*/pull/* | https://*/pull/*) return 0 ;;
    '' | *[!0-9]*) return 1 ;;
    *) return 0 ;; # bare PR number
  esac
}

echo "Fetching remotes..."
git fetch --all --prune

if is_pr_target "$TARGET"; then
  if ! command -v gh >/dev/null 2>&1; then
    echo "error: gh is required to check out a pull request" >&2
    exit 1
  fi
  echo "Checking out pull request: $TARGET"
  gh pr checkout "$TARGET"
else
  BRANCH="$TARGET"
  echo "Checking out branch: $BRANCH"
  if git show-ref --verify --quiet "refs/heads/${BRANCH}"; then
    git checkout "$BRANCH"
  elif git show-ref --verify --quiet "refs/remotes/origin/${BRANCH}"; then
    git checkout --track "origin/${BRANCH}" 2>/dev/null \
      || git checkout -B "$BRANCH" "origin/${BRANCH}"
  else
    echo "error: branch '${BRANCH}' not found locally or on origin" >&2
    exit 1
  fi
fi

BRANCH="$(git branch --show-current)"
echo "Pulling latest changes for ${BRANCH}..."
git pull --ff-only

MESSAGE="conduct a code review for branch ${BRANCH}, if find any major or minor issues please expand the issues"
echo "Starting pi review for ${BRANCH}..."
exec pi "$MESSAGE"
