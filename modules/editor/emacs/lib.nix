# Emacs through the nix-emacs-home library, as an alternative to ./default.nix +
# ./nima.nix.  Turned on with `modules.editors.emacs.useNixEmacsHome'; the old
# path stays one flag away.
#
# The library is a Home Manager module, so everything below lands in the user's
# Home Manager configuration: the features in ./features are read there, and the
# values they used to get from nima's `_module.args' are handed over the same
# way.
{
  config,
  lib,
  pkgs,
  inputs,
  ...
}:
let
  cfg = config.modules.editors.emacs;

  # Same patches ./nima.nix applies.
  emacsPackage = cfg.pkg.overrideAttrs (prev: {
    patches =
      (lib.optionals pkgs.stdenv.isDarwin [
        ./patches/system-appearance.patch
        ./patches/fix-ns-x-colors.patch
        ./patches/round-undecorated-frame.patch
      ])
      ++ prev.patches;
  });

  # The packages this config keeps outside nixpkgs.  Long term each of them
  # belongs in the `overlay' of the feature that uses it.
  emacsOverlay = import ./overrides.nix {
    inherit pkgs lib;
    packagePath = ../../../packages/emacs;
    emacsGhostel = import ./ghostel.nix {
      inherit pkgs;
      isDarwin = pkgs.stdenv.hostPlatform.isDarwin;
    };
  };
in
{
  options.modules.editors.emacs.useNixEmacsHome = lib.mkEnableOption ''
    configuring Emacs with the nix-emacs-home library instead of the nima glue
    in ./nima.nix
  '';

  config = lib.mkIf (cfg.enable && cfg.useNixEmacsHome) {
    home-manager.users.${config.my.username} =
      hm@{ ... }:
      let
        # The library's configured Emacs, wrapped with every feature package.
        emacsBin = hm.config.emacs.finalPackage;
      in
      {
        imports = [ inputs.nix-emacs-home.hmModules.default ];

        # The feature files ask for these; nima used to pass them.
        _module.args = {
          nixConfig = config;
          myConfig = config.my;
          lspStyle = cfg.lspStyle;
          homeDirectory = config.my.homeDirectory;
          workspaceDirectory = config.my.workspaceDirectory;
        };

        programs.emacs.enable = false;

        emacs = {
          enable = true;
          package = emacsPackage;
          featureDirs = [ ./features ];
          overlay = emacsOverlay;

          # Per-feature library options go here rather than into the feature
          # files, because ./features is shared with ./nima.nix and nima knows no
          # such options.  agent-shell must not be `(require)'d at startup:
          # hel-collection's agent-shell mode file defines its leader keymaps
          # after the `with-eval-after-load' that binds them, so loading that file
          # with agent-shell already loaded dies on
          # `hel-agent-shell-local-leader-map'.
          features.agent-shell.requireEpkgs = false;
          service.enable = cfg.enableService && !pkgs.stdenv.isDarwin;

          # Was generated by ./early-init.nix; the library writes the same file
          # out of options.
          earlyInitFile = ".emacs.d/early-init.el";
          earlyDefvar = {
            my-mono-font = {
              value = config.my.monoFont;
              doc = "Monospace font family selected from Nix.";
            };
            my-font = {
              value = config.my.font;
              doc = "Proportional font family selected from Nix.";
            };
          };
          earlyElisp = lib.optionalString pkgs.stdenv.isDarwin ''
            ;; `undecorated-round' keeps rounded corners via the local patch, but
            ;; on current NS Emacs/macOS it can still leave a visible titlebar
            ;; area, so also set the built-in `undecorated' early.
            (dolist (parameter '((undecorated . t)))
              (add-to-list 'default-frame-alist parameter)
              (add-to-list 'initial-frame-alist parameter))
          '';
          earlyElispFile = ./early-init.el;
        };

        # The Emacs itself, plus the two scripts that poke the running daemon.
        # The tools Emacs shells out to come from ./default.nix.
        home.packages = [
          (pkgs.writeShellScriptBin "app-launcher" ''
            ${emacsBin}/bin/emacsclient --eval "(consult-omni-app-launcher)"
          '')
          (pkgs.writeShellScriptBin "org-capture" ''
            ${emacsBin}/bin/emacsclient -n -e '(yequake-toggle "org-capture")'
          '')
        ];

        programs.zsh.sessionVariables.EDITOR = "${emacsBin}/bin/emacsclient -c -a '${emacsBin}/bin/emacs'";
      };
  };
}
