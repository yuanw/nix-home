
config wifi-device 'radio0'
	option type 'mac80211'
	option phy 'wl0'
	option cell_density '0'
	option country 'CA'
	option band '2g'
	option channel '6'
	option htmode 'HT20'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'NoneAndVoid'
	option encryption 'psk2'
	option key '@wireless_key@'

config wifi-device 'radio1'
	option type 'mac80211'
	option phy 'wl1'
	option band '5g'
	option channel '36'
	option htmode 'HE80'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'NoneAndVoid-5G'
	option encryption 'psk2'
	option key '@wireless_key@'

