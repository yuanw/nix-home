# Router recipes, imported by the root justfile -- run them as `just openwrt-...`
# from the repo root, not from here (the `nix` wrapper is defined upstream, and
# copying that incantation here is how it rots).
#
# --- openwrt (Linksys E8450) -------------------------------------------------
# Applying is a `uci batch` over ssh: every command stages into /tmp/.uci and only
# `uci commit` persists. Reviewing is therefore free. Two rules below, both learned
# the hard way:
# - Anonymous sections are WIPED (`uci -q delete x.@type[0]` until it errors), never
#   deleted by index: uci renumbers what is left after each delete, so indexing
#   leaves stale options merged into what gets re-added, and any fixed count silently
#   caps the list. The refs come from the batch's own `add` lines, so nothing here
#   depends on how many sections a router happens to have.
# - A copy read with a pending delta prints deleted anonymous sections as bare
#   `cfg<hash>` lines that no real config contains, and libuci writes that delta to
#   /tmp/.uci regardless of `-c`. So: commit inside the copy, show, revert the delta.
router_host := "192.168.1.1"
router := "e8450"

# sort both sides: a wipe-and-re-add moves sections to the end of the file, so an
# unsorted diff reports pure reordering as changes. Order is meaningless for
# dhcp/system/luci/rpcd/ubootenv/uhttpd; for firewall rules it *is* precedence, and
# they are not declared yet -- docs/openwrt-plan.org, phase 3.
show_committed := "uci show | sort"

# print the declared config as `uci batch` commands, with secrets interpolated
openwrt-eval:
    #!/usr/bin/env bash
    set -eu -o pipefail
    commands=$( {{nix}} build --quiet --no-link --print-out-paths ".#openwrt-{{router}}" )
    secrets=$(mktemp); trap 'rm -f "$secrets"' EXIT
    umask 077
    # empty reads must never reach uci: `pass`/`op` can both succeed with no output
    psk=$(pass openwrt/wifipw)
    test -n "$psk" || { echo 'empty wifi key from pass openwrt/wifipw' >&2; exit 1; }
    printf '{"wireless_key": "%s"}\n' "$psk" > "$secrets"
    NIX_UCI_SECRETS="$secrets" "$commands"

# what would change, with nothing on the router modified. The batch runs against
# /tmp/nix-uci-diff, a copy of the committed config.
openwrt-diff:
    #!/usr/bin/env bash
    set -eu -o pipefail
    host="root@{{router_host}}"
    batch=$(just openwrt-eval)
    wipes=$(printf '%s\n' "$batch" | awk '$1 == "add" { print $2 ".@" $3 }' | sort -u | tr '\n' ' ')
    after=$(printf '%s\n' "$batch" | ssh "$host" "
        rm -rf /tmp/nix-uci-diff
        mkdir -p /tmp/nix-uci-diff
        cp /etc/config/* /tmp/nix-uci-diff/
        for ref in $wipes; do
            while uci -q -c /tmp/nix-uci-diff delete \"\$ref[0]\"; do :; done
        done
        # batch prints the generated name of every add section: not config content.
        uci -c /tmp/nix-uci-diff batch > /dev/null
        for f in /tmp/nix-uci-diff/*; do
            uci -c /tmp/nix-uci-diff commit \"\$(basename \"\$f\")\" 2>/dev/null
        done
        uci -c /tmp/nix-uci-diff show | sort
        rm -rf /tmp/nix-uci-diff
        for f in /etc/config/*; do uci revert \"\$(basename \"\$f\")\" 2>/dev/null; done
        true")
    if diff -u <(ssh -n "$host" '{{show_committed}}') <(printf '%s\n' "$after"); then
        echo 'no changes: the router already matches the declared config'
    fi

# preview, then commit and reload on confirmation. Committing can drop the ssh
# session (wireless/network reload), so keep a console handy.
openwrt-apply:
    #!/usr/bin/env bash
    set -eu -o pipefail
    host="root@{{router_host}}"
    batch=$(just openwrt-eval)
    configs=$(printf '%s\n' "$batch" \
        | awk '{ if ($1 == "add") print $2; else { n = index($1, "."); if (n > 1) print substr($1, 1, n - 1) } }' | sort -u | tr '\n' ' ')
    wipes=$(printf '%s\n' "$batch" | awk '$1 == "add" { print $2 ".@" $3 }' | sort -u | tr '\n' ' ')

    before=$(ssh -n "$host" '{{show_committed}}')
    after=$(printf '%s\n' "$batch" | ssh "$host" "
        rm -rf /tmp/nix-uci-diff
        mkdir -p /tmp/nix-uci-diff
        cp /etc/config/* /tmp/nix-uci-diff/
        for ref in $wipes; do
            while uci -q -c /tmp/nix-uci-diff delete \"\$ref[0]\"; do :; done
        done
        uci -c /tmp/nix-uci-diff batch > /dev/null
        for f in /tmp/nix-uci-diff/*; do
            uci -c /tmp/nix-uci-diff commit \"\$(basename \"\$f\")\" 2>/dev/null
        done
        uci -c /tmp/nix-uci-diff show | sort
        rm -rf /tmp/nix-uci-diff
        for f in /etc/config/*; do uci revert \"\$(basename \"\$f\")\" 2>/dev/null; done
        true")
    diff -u <(printf '%s\n' "$before") <(printf '%s\n' "$after") || true
    # reload only what actually changed: a timezone edit must not bounce the radio.
    # Not 1:1 -- wireless is driven by netifd, dhcp by dnsmasq, no /etc/init.d/wireless.
    changed=$(diff <(printf '%s\n' "$before") <(printf '%s\n' "$after") \
        | sed -nE 's/^[-+]([a-z][a-z0-9_]*)\..*/\1/p' | sort -u || true)
    echo "configs to reload: ${changed:-none}"

    # ssh wants stdin, and `read` fails at EOF, which used to abort this recipe with
    # the batch still staged.
    answer=non
    read -r -p 'commit and reload? [y/N] ' answer || true
    if [ "$answer" != y ]; then
        echo 'left the router alone'
        exit 0
    fi

    ssh -n "$host" 'sysupgrade -b /tmp/pre-apply.tar.gz' || true
    # clean delta first so `uci commit` cannot sweep up a staged edit that is not
    # ours; then the same wipe, then stage for real.
    printf '%s\n' "$batch" | ssh "$host" "
        for f in /etc/config/*; do uci revert \"\$(basename \"\$f\")\" 2>/dev/null; done
        for ref in $wipes; do while uci -q delete \"\$ref[0]\"; do :; done; done
        uci batch > /dev/null"
    ssh -n "$host" "for c in $configs; do uci commit \$c; done"
    for cfg in $changed; do
        case $cfg in
            wireless|network) svc=network ;;
            dhcp) svc=dnsmasq ;;
            *) svc=$cfg ;;
        esac
        ssh -n "$host" "[ -x /etc/init.d/$svc ] && /etc/init.d/$svc reload" || true
        echo "reloaded $svc (for $cfg)"
    done
    ssh -n "$host" 'sync'
    echo '--- verifying: the diff should come back clean'
    just openwrt-diff

# discard staged-but-uncommitted changes in the configs we declare, and nothing
# else (the router had an unrelated `dhcp` delta that is not ours to undo).
openwrt-revert:
    #!/usr/bin/env bash
    set -eu -o pipefail
    configs=$(just openwrt-eval \
        | awk '{ if ($1 == "add") print $2; else { n = index($1, "."); if (n > 1) print substr($1, 1, n - 1) } }' | sort -u | tr '\n' ' ')
    ssh -n "root@{{router_host}}" "for c in $configs; do uci revert \$c 2>/dev/null; done"
    ssh -n "root@{{router_host}}" 'uci changes | wc -l' | xargs echo 'staged lines remaining:'

# snapshot the live config into state/ for drift detection. openwrt has busybox
# tar, not rsync, so the copy is a tar pipe rather than an rsync.
openwrt-facts:
    @rm -rf "$PWD/state/openwrt/{{router}}/live" && mkdir -p "$PWD/state/openwrt/{{router}}/live"
    @ssh -n "root@{{router_host}}" 'tar cf - -C /etc/config .' | tar xf - -C "$PWD/state/openwrt/{{router}}/live"
    @python3 "$PWD/openwrt/redact-config.py" "$PWD/state/openwrt/{{router}}/live"
    @echo "snapshot in state/openwrt/{{router}}/live -- git diff it to see what LuCI changed"
