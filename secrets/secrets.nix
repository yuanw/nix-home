let
  user1 = "ssh-rsa ";
  yuanwang_wv = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHM9A47jwAmysQRtmnDdfXtV1Slt8irXG2UsDZUn41rS";
  yuanwang_ca = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFpYgmWwtRG7vlRbtWheYrtHl9E9qx84sdU+YlE8w+CZ";
  yuanw_mist = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHUg80LmE2cirl2gPfmShkWZh68eIvlD6Uc3swGfcAwY";
  users = [
    user1
    yuanwang_wv
    yuanwang_ca
    yuanw_mist
  ];
  ashe = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINLStUG7iJOYDhS3GLuI0LkvSiY9fqsw2bM5p9JfoUqf";
  adguard = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEvgQaTxQmNGhbmkXYXmeTcbHo6vnpC0h0olTIErZxIC";
  misfit = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDx+Da0GK5PP3hskYnLn1zd/2iPnLMKl0S6Q2o+f/DEQ";
  dgx-spark = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBlf8iV/U+IO22PGc6yZMbfwZB7Wpk7L7nD9AZApwQBS";
  # silver's SSH host key, generated by its first NixOS boot
  silver = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOM+RJXHC7SOXSWpgeG1Tr2Hpfa102G2YDq/C2qSLlQ0";
  systems = [
    ashe
    adguard
    misfit
    dgx-spark
    silver
  ];
in
{
  "openrouter.age".publicKeys = [
    yuanw_mist
    yuanwang_wv
    yuanwang_ca
  ];
  "secret1.age".publicKeys = users ++ systems;
  "adguard.age".publicKeys = users ++ systems;
  "isponsorblockvg.age".publicKeys = [
    yuanw_mist
    misfit
  ];
  "namecheap.age".publicKeys = [
    yuanw_mist
    misfit
  ];
  "jellyfin-admin.age".publicKeys = [
    yuanw_mist
    misfit
  ];
  "hass.age".publicKeys = users ++ systems;
  "adguard-encryption-key.age".publicKeys = users ++ systems;
  "adguard-encryption-certificate.age".publicKeys = users ++ systems;
  "wireguard-server-private.age".publicKeys = users ++ systems;
  "hf-token.age".publicKeys = [
    yuanw_mist
    yuanwang_ca
    dgx-spark
  ];
  # PSK for the NoneAndVoid Wi-Fi, consumed by
  # networking.networkmanager.ensureProfiles on silver. silver itself is added
  # as a recipient after its first install; see docs/nixos-macbook-pro-plan.org
  # Step 6 for the rekey commands.
  "wifi.age".publicKeys = users ++ systems;
  # Harmonia signs the .narinfo files it serves with this key, so it is the
  # cache's identity: consumers pin `silver-1:<b64>` in trusted-public-keys and
  # the name is baked into the secret (docs/harmonia-build-hub.org D4).  Only
  # the publishing host needs the private half, hence no `users` and no
  # `systems` here.  Add `misfit` if the cache ever goes mutual, then agenix -r.
  "harmonia-sign-key.age".publicKeys = [ silver ];
  # The key silver's nix daemon uses to reach the three builders (Phase 3.1).
  # Like the signing key it belongs to the hub, not to a person: only silver
  # decrypts it, and the builders get the public half through
  # users.users.*.openssh.authorizedKeys.keys.  Losing it is not fatal —
  # regenerate, agenix -e again, redeploy the three hosts and silver.
  "nix-builder-key.age".publicKeys = [ silver ];
}
